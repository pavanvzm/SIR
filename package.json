{
  "name": "sir-mcp-checker",
  "version": "1.0.0",
  "description": "Cross-Platform MCP SIR Status Checker for System Incident Response monitoring",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:dashboard\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:dashboard": "cd src/dashboard && npm run dev",
    "build": "tsc && cd src/dashboard && npm run build",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:rollback": "tsx src/db/migrate.ts rollback",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "pdf:guide": "tsx scripts/generatePdfGuide.ts"
  },
  "keywords": [
    "mcp",
    "sir",
    "incident-response",
    "monitoring",
    "cross-platform"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "knex": "^3.1.0",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "pdfkit": "^0.14.0",
    "os": "^0.1.2",
    "crypto-js": "^4.2.0",
    "uuid": "^9.0.1",
    "nodemailer": "^6.9.8",
    "axios": "^1.6.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.9",
    "@types/ws": "^8.5.10",
    "@types/cors": "^2.8.17",
    "@types/pdfkit": "^0.13.3",
    "@types/crypto-js": "^4.2.1",
    "@types/uuid": "^9.0.7",
    "@types/nodemailer": "^6.4.14",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
